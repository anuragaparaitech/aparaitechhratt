{
  "manifest_version": 3,
  "name": "Aparaitech Work Portal",
  "version": "1.0.0",
  "description": "Desktop shortcut and quick access extension for Aparaitech Software Employee Attendance & Performance Portal",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Aparaitech Work Portal"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "windows",
    "tabs"
  ]
}
